# 开发环境变量
# 注意：只有以 VITE_ 开头的变量才会被暴露给客户端代码

# 应用标题
VITE_APP_TITLE = AurumCRM

# 接口前缀（前端请求统一以此开头，由 vite.config.js 代理转发）
VITE_APP_BASE_API = /api

# 后端真实地址（仅开发环境代理使用，不会打进前端产物）
#
# ⚠️ 只保留一行：dotenv 重复声明时「后者覆盖前者」，曾因两行并存导致
#    实际连的是另一台后端，排查问题时极易被带偏（2026-09-15）
#
# ⚠️ 改这里**必须重启 `npm run dev`** —— vite.config.js 是在启动时
#    loadEnv 读一次的，改完不重启，代理还打向旧地址。
#
# 指向远端（如 YOUR_SERVER_IP:8080）时请先确认那台**已经换上新构建的 jar**：
# 曾经前端连远端、人却在本地重启后端，于是「明明用了最新的后端却没有新字段」。
VITE_APP_API_TARGET = http://localhost:8080

# 是否启用本地 mock
# true  = 用 src/mock/ 的假数据跑通前端（后端没接上时的退路）
# false = 走后端真实接口
#
# ⚠️ 这是【全局开关】，9 个 api 模块共用，不是只影响认证。
#
# ⚠️⚠️ **不要在这里维护「后端已实现哪些模块」的清单。**
#     曾经有一份，写的是「只实现了 /auth/* 和 /crm/customer」，
#     后端补齐后没人回来改，结果把排查问题的人（包括我）带偏过一次。
#     后端在快速迭代，这份清单只会腐烂。
#
#     **要查实际可用性，用命令，别用注释**：
#       - 前端请求路径能否在接口文档里找到：`npm run check:api`
#       - 后端真实路由：Knife4j 文档页 http://localhost:8080/doc.html
#       - 各接口接入状态：`npm run gen:api-status` 生成的 docs/接口清单.txt
#
# 截至 2026-09-13 的已知缺口（**会过时，仅供参考**）：
#   ❌ 财务（回款 / 发票与开票）、审批流 /bpm/*、
#      组织机构增删改（只有部门树）、编号定义、登陆日志 / 操作日志、公告、
#      公海规则、联系人、开票信息、操作记录、客户共享、线索转客户、
#      以及除「客户导出（CSV）」之外的导出接口
#      （看板的 /dashboard/focus 对 payment / invoice 两个页签返回空页，
#        原因同财务模块缺失）
VITE_APP_USE_MOCK = false
